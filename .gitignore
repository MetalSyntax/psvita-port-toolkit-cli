# macOS metadata (frecuente en discos externos no-HFS+, ej. este Seagate)
.DS_Store
._*
.Spotlight-V100
.Trashes

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Generated API reference (regenerate with dev-tools/gen_docs.py --api-only) --
# docs/dev-notes/ is hand-written and committed, docs/api/ is a build artifact.
/docs/api/

# doxygen scratch output, if the real tool is used instead of the fallback
/docs/doxygen-xml/

# IDE
.vscode/
.idea/
*.swp

# Local planning scratch docs (not part of the shipped toolkit) --
# docs/dev-notes/*.md and README.md stay tracked, see the comment above.
/PLAN_PSVITA_PORT_TOOLKIT_V*.md
/PLAN_STATUS.md
/docs/plan_V4_status.md
